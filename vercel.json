{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "holisticcreativestudios.com"
        }
      ],
      "destination": "/studio/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.holisticcreativestudios.com"
        }
      ],
      "destination": "/studio/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "longevityconcierge.vercel.app"
        }
      ],
      "destination": "https://www.longevityconcierge.app/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/j/:slug",
      "destination": "/index.html"
    }
  ]
}