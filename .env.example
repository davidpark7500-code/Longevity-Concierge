# Nothing is required: the app uses the live Supabase project by default.
# Optional overrides for the browser build (prefixed VITE_, safe to expose):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_BOOKING_URL=
VITE_CIRCLE_PRICE_LABEL=$25/month
VITE_DEMO=

# Server secrets do NOT go here. Set them in Supabase -> Edge Functions -> Secrets:
# ANTHROPIC_API_KEY, ANTHROPIC_MODEL, APP_TIMEZONE, AI_GLOBAL_DAILY_CAP, APP_URL,
# STRIPE_SECRET_KEY, STRIPE_PRICE_CIRCLE, STRIPE_WEBHOOK_SECRET
